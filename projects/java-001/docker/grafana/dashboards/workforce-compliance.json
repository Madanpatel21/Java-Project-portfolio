{
  "title": "JAVA-001 Workforce Compliance",
  "uid": "java001",
  "panels": [
    {
      "title": "Evidence appends /s",
      "type": "timeseries",
      "targets": [{"expr": "rate(workforce_evidence_appends_total[1m])", "legendFormat": "appends"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Open violations",
      "type": "stat",
      "targets": [{"expr": "workforce_violations_open"}],
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "title": "Violations detected /m",
      "type": "timeseries",
      "targets": [{"expr": "rate(workforce_violations_detected_total[1m])", "legendFormat": "detected"}],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    },
    {
      "title": "Ingested access events /s",
      "type": "timeseries",
      "targets": [{"expr": "rate(workforce_ingest_events_total[1m])", "legendFormat": "events"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Correlation run duration (s)",
      "type": "timeseries",
      "targets": [{"expr": "workforce_correlation_duration_seconds_max", "legendFormat": "max"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "title": "Export jobs",
      "type": "stat",
      "targets": [{"expr": "workforce_export_jobs_total"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "title": "HTTP request rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{method}} {{uri}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
