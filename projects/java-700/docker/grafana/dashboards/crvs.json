    {"title": "Registrations approved /m", "type": "timeseries",
     "targets": [{"expr": "rate(crvs_registrations_approved_total[1m])", "legendFormat": "approved"}],
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}},
    {"title": "Certificates issued", "type": "stat",
     "targets": [{"expr": "crvs_certificates_issued_total"}],
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}},
    {"title": "Dedup candidates detected", "type": "stat",
     "targets": [{"expr": "crvs_dedup_candidates_total"}],
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"title": "Open registrations", "type": "stat",
     "targets": [{"expr": "crvs_registrations_open"}],
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"title": "HTTP request rate", "type": "timeseries",
     "targets": [{"expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{method}} {{uri}}"}],
